<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WinBridge" Manufacturer="MacBridge" Version="$(var.Version)"
           UpgradeCode="7B20C979-A97C-47B7-A719-460B93DCD6C8" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer WinBridge version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="WinBridge">
          <Component Id="WinBridgeExecutable" Guid="*">
            <File Id="WinBridgeExe" Source="$(var.Payload)\winbridge.exe" KeyPath="yes">
              <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder"
                        Name="WinBridge" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
            </File>
          </Component>
          <Component Id="WinBridgeConfig" Guid="*" NeverOverwrite="yes">
            <File Id="WinBridgeConfigFile" Source="$(var.Payload)\winbridge.json" KeyPath="yes" />
          </Component>
          <Component Id="WinBridgeReadme" Guid="*">
            <File Id="WinBridgeReadmeFile" Source="$(var.Payload)\README.txt" KeyPath="yes" />
          </Component>
          <Component Id="WinBridgeAutoStart" Guid="*">
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="WinBridge" Value="&quot;[#WinBridgeExe]&quot;" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <CustomAction Id="LaunchWinBridge" FileRef="WinBridgeExe" Execute="immediate"
                  Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchWinBridge" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
    <Feature Id="MainFeature" Title="WinBridge">
      <ComponentRef Id="WinBridgeExecutable" />
      <ComponentRef Id="WinBridgeConfig" />
      <ComponentRef Id="WinBridgeReadme" />
      <ComponentRef Id="WinBridgeAutoStart" />
    </Feature>
  </Package>
</Wix>
